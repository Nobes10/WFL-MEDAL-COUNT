{
  "name": "wfl-medal-count",
  "version": "0.1.8",
  "description": "Whyalla Football League medal count — enter 3-2-1 before the night, present offline",
  "author": "Whyalla Football League",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/build-electron.mjs && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "icon": "node scripts/make-icon.mjs",
    "build": "npm run icon && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "start:app": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "publish:win": "npm run build && electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nobes10/WFL-MEDAL-COUNT.git"
  },
  "build": {
    "appId": "au.com.whyallafootball.medal-count",
    "productName": "WFL Medal Count",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@imgly/**/*",
      "node_modules/sharp/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/@imgly/background-removal-node/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WFL Medal Count",
      "artifactName": "WFL-Medal-Count-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "WFL-Medal-Count-Portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Nobes10",
      "repo": "WFL-MEDAL-COUNT",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "color-name": "^1.1.4",
    "color-string": "^1.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
